{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scanner": {
    "MaxFileBytes": 104857600,
    "MaxArchiveBytes": 209715200,
    "MaxUncompressedBytes": 1073741824,
    "MaxEntries": 500,
    "MaxCompressionRatio": 100,
    "MaxEntryBytes": 104857600,
    "MaxScanSeconds": 120,
    "MaxParallelScans": 4,
    "TempStorageBasePath": null,
    "CatalogBasePath": null
  },
  "WebScanner": {
    "AllowedOrigins": [
      "http://localhost:5290",
      "http://127.0.0.1:5290",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "https://localhost:7268",
      "https://127.0.0.1:7268",
      "https://else.fcim.utm.md/",
      "https://dating-tgg.vercel.app/"
    ],
    "AllowPrivateNetworkTargets": false,
    "MaxPages": 8,
    "MaxRequests": 20,
    "MaxRedirects": 2,
    "MaxResponseBytes": 1048576,
    "RequestsPerSecond": 2,
    "TimeoutSeconds": 20,
    "MaxScanSeconds": 60,
    "MaxAuthProbeAttempts": 5,
    "MaxActiveProbes": 3
  },
  "RateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  }
}
