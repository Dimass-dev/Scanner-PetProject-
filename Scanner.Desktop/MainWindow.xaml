<Window x:Class="Scanner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scanner.Desktop"
        xmlns:vm="clr-namespace:Scanner.Desktop.ViewModels"
        xmlns:conv="clr-namespace:Scanner.Desktop.Converters"
        mc:Ignorable="d"
        Title="Security Scanner"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Foreground="#212121"
        AllowDrop="True"
        Drop="Window_Drop"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <conv:RiskLevelToColorConverter x:Key="RiskLevelToColorConverter"/>
        <conv:BoolToYesNoConverter x:Key="BoolToYesNoConverter"/>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:SeverityToColorConverter x:Key="SeverityToColorConverter"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Security Scanner"
                             FontSize="24"
                             FontWeight="Bold"
                             Foreground="#212121"/>
                    <TextBlock Text="PE File and Archive Security Analysis Tool"
                             FontSize="12"
                             Foreground="#757575"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding IsServerConnected, Converter={StaticResource RiskLevelToColorConverter}, ConverterParameter=Status}"
                            CornerRadius="12"
                            Padding="10,5"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding IsServerConnected, Converter={StaticResource RiskLevelToColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding IsServerConnected, StringFormat='Server: {0}'}"
                                     Foreground="White"
                                     FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🔄 Refresh"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding CheckServerConnectionCommand}"
                            Margin="0,0,10,0"/>

                    <Button Content="🗑️ Clear History"
                            Style="{StaticResource ModernButton}"
                            Background="#FF5722"
                            Command="{Binding ClearHistoryCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border"
                                        Background="White"
                                        BorderThickness="0"
                                        CornerRadius="8,8,0,0"
                                        Margin="2,0"
                                        Padding="20,10">
                                    <ContentPresenter x:Name="ContentSite"
                                                    ContentSource="Header"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    TextElement.Foreground="#757575"
                                                    TextElement.FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="White"/>
                                        <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="Bold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- PE File Scanner Tab -->
            <TabItem Header="📄 PE File Scanner">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - Upload and Actions -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardBorder}"
                            AllowDrop="True"
                            Drop="FileDropZone_Drop"
                            DragOver="FileDropZone_DragOver">
                        <StackPanel>
                            <TextBlock Text="Scan PE File"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     Margin="0,0,0,20"/>

                            <Border x:Name="PeDropZone"
                                    BorderBrush="#BDBDBD"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="40"
                                    Background="#FAFAFA"
                                    MinHeight="200"
                                    DragEnter="DropZone_DragEnter"
                                    DragLeave="DropZone_DragLeave">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📁"
                                             FontSize="48"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="Drag and drop PE file here"
                                             Foreground="#212121"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             HorizontalAlignment="Center"
                                             Margin="0,10,0,5"/>
                                    <TextBlock Text="or"
                                             FontSize="12"
                                             Foreground="#757575"
                                             HorizontalAlignment="Center"
                                             Margin="0,5"/>
                                    <Button Content="Browse Files"
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding SelectAndScanFileCommand}"
                                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                            Margin="0,10"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Supported formats: .exe, .dll, .sys"
                                     FontSize="11"
                                     Foreground="#757575"
                                     Margin="0,10,0,0"
                                     HorizontalAlignment="Center"/>

                            <ProgressBar IsIndeterminate="True"
                                       Height="4"
                                       Margin="0,20,0,0"
                                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Right Panel - Results -->
                    <ScrollViewer Grid.Column="1"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding CurrentScanResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Margin="10">
                            <!-- Risk Summary -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Risk Assessment"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Margin="0,0,0,15"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="File Name"
                                                     Foreground="#757575"
                                                     FontSize="12"/>
                                            <TextBlock Text="{Binding CurrentScanResult.FileName}"
                                                     Foreground="#212121"
                                                     FontWeight="Bold"
                                                     FontSize="14"
                                                     Margin="0,5,0,15"
                                                     TextWrapping="Wrap"/>

                                            <TextBlock Text="File Size"
                                                     Foreground="#757575"
                                                     FontSize="12"/>
                                            <TextBlock Text="{Binding CurrentScanResult.FileSize, Converter={StaticResource FileSizeConverter}}"
                                                     Foreground="#212121"
                                                     FontWeight="Bold"
                                                     FontSize="14"
                                                     Margin="0,5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Risk Level"
                                                     Foreground="#757575"
                                                     FontSize="12"/>
                                            <Border Background="{Binding CurrentScanResult.RiskLevel, Converter={StaticResource RiskLevelToColorConverter}}"
                                                    CornerRadius="20"
                                                    Padding="15,8"
                                                    Margin="0,5,0,15">
                                                <TextBlock Text="{Binding CurrentScanResult.RiskLevel}"
                                                         Foreground="White"
                                                         FontWeight="Bold"
                                                         FontSize="16"
                                                         HorizontalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="Total Score"
                                                     Foreground="#757575"
                                                     FontSize="12"/>
                                            <TextBlock Text="{Binding CurrentScanResult.TotalScore}"
                                                     Foreground="#212121"
                                                     FontWeight="Bold"
                                                     FontSize="24"
                                                     HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Security Mitigations -->
                            <Border Style="{StaticResource CardBorder}"
                                    Visibility="{Binding CurrentScanResult.Mitigations, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Security Mitigations"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Margin="0,0,0,15"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="{Binding CurrentScanResult.Mitigations.Aslr, Converter={StaticResource BoolToYesNoConverter}}"
                                                     FontSize="16"
                                                     Margin="0,0,10,0"/>
                                            <TextBlock Text="ASLR" FontSize="14"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="{Binding CurrentScanResult.Mitigations.Dep, Converter={StaticResource BoolToYesNoConverter}}"
                                                     FontSize="16"
                                                     Margin="0,0,10,0"/>
                                            <TextBlock Text="DEP" FontSize="14"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="{Binding CurrentScanResult.Mitigations.Cfg, Converter={StaticResource BoolToYesNoConverter}}"
                                                     FontSize="16"
                                                     Margin="0,0,10,0"/>
                                            <TextBlock Text="CFG" FontSize="14"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="{Binding CurrentScanResult.Mitigations.SafeSeh, Converter={StaticResource BoolToYesNoConverter}}"
                                                     FontSize="16"
                                                     Margin="0,0,10,0"/>
                                            <TextBlock Text="SafeSEH" FontSize="14"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="{Binding CurrentScanResult.Mitigations.HighEntropyVa, Converter={StaticResource BoolToYesNoConverter}}"
                                                     FontSize="16"
                                                     Margin="0,0,10,0"/>
                                            <TextBlock Text="High Entropy VA" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Findings -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Findings"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Margin="0,0,0,15"/>

                                    <ItemsControl ItemsSource="{Binding CurrentScanResult.Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E0E0E0"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Background="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}"
                                                                CornerRadius="4"
                                                                Padding="8,4"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Severity}"
                                                                     Foreground="White"
                                                                     FontSize="11"
                                                                     FontWeight="Bold"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Message}"
                                                                     FontWeight="Medium"
                                                                     TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Details}"
                                                                     FontSize="12"
                                                                     Foreground="#757575"
                                                                     TextWrapping="Wrap"
                                                                     Margin="0,5,0,0"
                                                                     Visibility="{Binding Details, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                 Text="{Binding Score, StringFormat='+{0} pts'}"
                                                                 FontWeight="Bold"
                                                                 VerticalAlignment="Top"
                                                                 Margin="10,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Archive Scanner Tab -->
            <TabItem Header="📦 Archive Scanner">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardBorder}"
                            AllowDrop="True"
                            Drop="ArchiveDropZone_Drop"
                            DragOver="FileDropZone_DragOver">
                        <StackPanel>
                            <TextBlock Text="Scan ZIP Archive"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     Margin="0,0,0,20"/>

                            <Border x:Name="ArchiveDropZone"
                                    BorderBrush="#BDBDBD"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="40"
                                    Background="#FAFAFA"
                                    MinHeight="200"
                                    DragEnter="DropZone_DragEnter"
                                    DragLeave="DropZone_DragLeave">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📦"
                                             FontSize="48"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="Drag and drop ZIP archive here"
                                             Foreground="#212121"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             HorizontalAlignment="Center"
                                             Margin="0,10,0,5"/>
                                    <TextBlock Text="or"
                                             FontSize="12"
                                             Foreground="#757575"
                                             HorizontalAlignment="Center"
                                             Margin="0,5"/>
                                    <Button Content="Browse Archives"
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding SelectAndScanArchiveCommand}"
                                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                            Margin="0,10"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Supported format: .zip"
                                     FontSize="11"
                                     Foreground="#757575"
                                     Margin="0,10,0,0"
                                     HorizontalAlignment="Center"/>

                            <ProgressBar IsIndeterminate="True"
                                       Height="4"
                                       Margin="0,20,0,0"
                                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Right Panel - Archive Results -->
                    <ScrollViewer Grid.Column="1"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding CurrentArchiveResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Margin="10">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Archive Summary"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Margin="0,0,0,15"/>

                                    <TextBlock>
                                        <Run Text="Archive: " Foreground="#757575"/>
                                        <Run Text="{Binding CurrentArchiveResult.ArchiveName, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,5">
                                        <Run Text="Files Scanned: " Foreground="#757575"/>
                                        <Run Text="{Binding CurrentArchiveResult.ScannedFiles, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text=" / " Foreground="#757575"/>
                                        <Run Text="{Binding CurrentArchiveResult.TotalFiles, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding CurrentArchiveResult.Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}">
                                            <Expander Header="{Binding FileName}" IsExpanded="False">
                                                <StackPanel Margin="10">
                                                    <Grid Margin="0,10,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock>
                                                                <Run Text="Size: " Foreground="#757575"/>
                                                                <Run Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,5">
                                                                <Run Text="Score: " Foreground="#757575"/>
                                                                <Run Text="{Binding TotalScore, Mode=OneWay}" FontWeight="Bold"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Background="{Binding RiskLevel, Converter={StaticResource RiskLevelToColorConverter}}"
                                                                CornerRadius="15"
                                                                Padding="12,6">
                                                            <TextBlock Text="{Binding RiskLevel}"
                                                                     Foreground="White"
                                                                     FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Text="Findings:"
                                                             FontWeight="Bold"
                                                             Margin="0,10,0,5"/>
                                                    <ItemsControl ItemsSource="{Binding Findings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="#E0E0E0"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="0,5">
                                                                    <StackPanel>
                                                                        <TextBlock>
                                                                            <Run Text="{Binding Severity, Mode=OneWay}"
                                                                                 Foreground="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}"
                                                                                 FontWeight="Bold"/>
                                                                            <Run Text=" - "/>
                                                                            <Run Text="{Binding Message, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- History Tab -->
            <TabItem Header="📜 History">
                <Border Background="White" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScanHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}"
                                                         FontWeight="Bold"
                                                         FontSize="14"/>
                                                <TextBlock Margin="0,5">
                                                    <Run Text="Size: " Foreground="#757575"/>
                                                    <Run Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}, Mode=OneWay}"/>
                                                    <Run Text=" | Score: " Foreground="#757575"/>
                                                    <Run Text="{Binding TotalScore, Mode=OneWay}" FontWeight="Bold"/>
                                                    <Run Text=" | Findings: " Foreground="#757575"/>
                                                    <Run Text="{Binding Findings.Count, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{Binding RiskLevel, Converter={StaticResource RiskLevelToColorConverter}}"
                                                    CornerRadius="15"
                                                    Padding="12,6"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RiskLevel}"
                                                         Foreground="White"
                                                         FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#2196F3"
                CornerRadius="4"
                Padding="15,10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                         Text="{Binding StatusMessage}"
                         Foreground="White"
                         FontSize="12"
                         VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="🔒 "
                             Foreground="White"
                             FontSize="14"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Local scanning only - Files never leave your machine"
                             Foreground="White"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Opacity="0.9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
